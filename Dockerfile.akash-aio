# All-in-One Dockerfile for Akash (includes Redis)
FROM node:18-alpine

# Install Redis, Chrome, and Python dependencies
RUN apk add --no-cache \
    redis \
    python3 \
    py3-pip \
    chromium \
    chromium-chromedriver \
    bash \
    supervisor \
    && rm -rf /var/cache/apk/*

# Set Chrome binary location for Selenium
ENV CHROME_BIN=/usr/bin/chromium-browser \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver \
    NODE_ENV=production \
    REDIS_HOST=127.0.0.1 \
    REDIS_PORT=6379

WORKDIR /app

# Copy package files  
COPY package*.json ./

# Install all dependencies including dev for build
RUN npm install --include=dev

# Copy all source code
COPY . .

# Install Python dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt --break-system-packages

# Build frontend
RUN npm run build

# Remove dev dependencies after build
RUN npm prune --production

# Create supervisord config
RUN cat > /etc/supervisord.conf << 'EOF'
[supervisord]
nodaemon=true
user=root

[program:redis]
command=redis-server --bind 127.0.0.1 --port 6379
autostart=true
autorestart=true
stdout_logfile=/var/log/redis.log
stderr_logfile=/var/log/redis.log

[program:app]
command=node server/index.js
directory=/app
autostart=true
autorestart=true
stdout_logfile=/var/log/app.log
stderr_logfile=/var/log/app.log
environment=NODE_ENV="production",REDIS_HOST="127.0.0.1",REDIS_PORT="6379"
EOF

# Create log directory
RUN mkdir -p /var/log

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (r) => {r.statusCode === 200 ? process.exit(0) : process.exit(1)})"

# Start both Redis and the app using supervisord
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]