# Akash Deployment Environment Variables
# Copy this to .env.akash and fill in your values

# Supabase Configuration (REQUIRED)
# Get these from your Supabase project settings
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-1-us-west-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Redis Configuration (Internal - don't change)
REDIS_HOST=redis
REDIS_PORT=6379

# Server Configuration
NODE_ENV=production
PORT=3001

# Security (CHANGE THESE!)
SESSION_SECRET=generate-a-random-64-character-string-here
JWT_SECRET=generate-another-random-64-character-string-here

# Frontend URL (your Akash deployment URL)
CLIENT_URL=https://your-akash-deployment.com

# Optional: Monitoring
ENABLE_MONITORING=false
LOG_LEVEL=info