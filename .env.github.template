# GitHub Actions Setup Credentials Template
# Copy this file to .env.github and fill in your actual values
# DO NOT commit .env.github to version control!

# GitHub Personal Access Token
# Required permissions: repo, workflow
# Create at: https://github.com/settings/tokens/new
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Repository (format: owner/repo-name)
# Example: stavarc/justice-watch-az
GITHUB_REPO=owner/repository-name

# Supabase Project URL
# Found in: Supabase Dashboard > Settings > API
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (public)
# Found in: Supabase Dashboard > Settings > API > anon public
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (secret - keep secure!)
# Found in: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_KEY=your_service_role_key_here