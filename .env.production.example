# Production Supabase Configuration
# Copy this file to .env.production and fill in your actual values

# Frontend environment variables (exposed to browser)
VITE_SUPABASE_URL=https://[PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Backend/Scraper environment variables (server-side only)
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-key...

# Database connection (optional, for direct access)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres

# GitHub Actions environment (set as repository secrets)
# SUPABASE_URL
# SUPABASE_SERVICE_KEY
# NETLIFY_AUTH_TOKEN
# NETLIFY_SITE_ID