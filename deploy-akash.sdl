---
version: "2.0"

services:
  app:
    image: arealicehole/justice-watch:prod.01
    env:
      - NODE_ENV=production
      - REDIS_HOST=localhost
      - REDIS_PORT=6379
      # These will be set in Cloudmos deployment
      - SUPABASE_URL=
      - SUPABASE_SERVICE_KEY=
      - DATABASE_URL=
      - JWT_SECRET=
      - SESSION_SECRET=
    expose:
      - port: 3001
        as: 80
        to:
          - global: true
        accept:
          - justice-watch.akash.network
    command:
      - "sh"
      - "-c"
      - "redis-server --daemonize yes && node server/index.js"

profiles:
  compute:
    app:
      resources:
        cpu:
          units: 2.0
        memory:
          size: 4Gi
        storage:
          size: 10Gi
  placement:
    dcloud:
      attributes:
        host: akash
      signedBy:
        anyOf:
          - "akash1365yvmc4s7awdyj3n2sav7xfx76adc6dnmlx63"
          - "akash18qa2a2ltfyvkyj0ggj3hkvuj6twzyumuaru9s4"
      pricing:
        app:
          denom: uakt
          amount: 1000

deployment:
  app:
    dcloud:
      profile: app
      count: 1