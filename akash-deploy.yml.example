---
version: "2.0"

services:
  web:
    # Replace with your Docker Hub image (current: arealicehole/justice-watch-scraper:A1-4)
    image: yourdockerhub/justice-watch-scraper:A1-4
    env:
      # Replace these with your actual Supabase credentials
      - SUPABASE_URL=your_production_supabase_url_here
      - SUPABASE_SERVICE_KEY=your_production_service_key_here
      - SCHEDULE_ENABLED=true      # true = run on schedule, false = run once
      - RUN_ON_STARTUP=true        # true = run immediately on deploy
      - CHROME_HEADLESS=true       # Keep true for production
    expose:
      - port: 3000
        as: 80
        to:
          - global: true

profiles:
  compute:
    web:
      resources:
        cpu:
          units: 0.5        # 0.5 vCPU is sufficient
        memory:
          size: 1Gi         # 1GB RAM minimum for Chrome
        storage:
          size: 512Mi       # 512MB for container and logs
  
  placement:
    westcoast:
      attributes:
        host: akash
      signedBy:
        anyOf:
          # Popular Akash providers - add more as needed
          - "akash1365yvmc4s7awdyj3n2sav7xfx76adc6dnmlx63"  # Europlots
          - "akash18qa2a2ltfyvkyj0ggj3hkvuj6twzyumuaru9s4"  # Overclock Labs
      pricing:
        web:
          denom: uakt
          amount: 1000      # Adjust based on current market rates

deployment:
  web:
    westcoast:
      profile: web
      count: 1              # Single instance

# IMPORTANT NOTES:
# 1. Service name 'web' must match in all sections
# 2. Replace Docker image with your own: arealicehole/justice-watch-scraper:A1-2
# 3. Add your Supabase credentials before deploying
# 4. The scraper runs at 9 AM MST Monday-Friday when SCHEDULE_ENABLED=true
# 5. Set RUN_ON_STARTUP=false if you don't want immediate execution